DATABASE_URL=postgresql+asyncpg://abby:abby@localhost:5432/abby
REDIS_URL=redis://localhost:6379/0
ENV=dev
POSTGRES_PASSWORD=
JWT_SECRET=change-me
AI_MODEL=gpt-4.1
OPENAI_API_KEY=
BRAPI_TOKEN=
AI_TIMEOUT_S=10
STT_URL=http://stt:8000
STT_MODEL=small
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=  # prod: 16+ chars [A-Za-z0-9_-], sem "change-me"
TELEGRAM_BOT_USERNAME=
EVOLUTION_URL=  # prod: http://evolution:8080
EVOLUTION_DB_PASSWORD=change-me-url-safe  # só [A-Za-z0-9_-] (vai numa URL)
EVOLUTION_API_KEY=change-me-evolution-key  # prod: 16+ chars, trocar
EVOLUTION_INSTANCE=abby-cash
EVOLUTION_WEBHOOK_SECRET=  # 16+ chars [A-Za-z0-9_-]
STORAGE_DIR=./storage
# prod: https://abbycash.abbysystems.com.br (o compose já fixa)
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_TZ=America/Sao_Paulo
# obrigatória em prod: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENC_KEY=
# CIDRs do proxy que pode mandar X-Forwarded-For (prod: o compose já fixa); vazio = ninguém
TRUSTED_PROXIES=
# prod atrás de TLS: true (o compose já fixa)
HSTS=false
# chave PÚBLICA do age (age1...); a privada fica com o dono, offline
BACKUP_AGE_RECIPIENT=
# chat do Telegram do admin que recebe alertas de falha do backup
BACKUP_ADMIN_CHAT_ID=
# opcional (depois): gdrive:abby-cash-backups; vazio = só backup local
BACKUP_RCLONE_REMOTE=
# prod: obrigatória (Redis do app com requirepass); só [A-Za-z0-9_-] (vai na REDIS_URL)
REDIS_PASSWORD=change-me-redis-password
# prod: obrigatória, versão explícita das imagens (ex.: v1.0.0); sem `latest`
ABBY_TAG=v0.0.0  # trocar pela tag publicada
# tetos de custo/abuso (padrões abaixo)
MSG_RATE_PER_HOUR=60
AI_DAILY_TOKEN_BUDGET=200000
STT_DAILY_SECONDS=1800
